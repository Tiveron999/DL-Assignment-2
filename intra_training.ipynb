    "def count_total_segments(filepaths, label_map, window_size=500, stride=500, downsample_factor=20):\n",
    "    total = 0\n",
    "    for fp in filepaths:\n",
    "        segments, _ = load_and_preprocess(fp, label_map, window_size, stride, downsample_factor)\n",
    "        total += len(segments)\n",
    "    return total\n"
   ]
