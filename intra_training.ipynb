    "def segment_data(data, label, window_size=500, stride=500):\n",
    "    segments = []\n",
    "    labels = []\n",
    "    for start in range(0, data.shape[1] - window_size + 1, stride):\n",
    "        end = start + window_size\n",
    "        segment = data[:, start:end]\n",
    "        segments.append(segment)\n",
    "        labels.append(label)\n",
    "    return segments, labels"
   ]
  },
